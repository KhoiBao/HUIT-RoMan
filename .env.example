# Sao chép file này thành .env rồi chỉnh nếu cần:
#   Copy-Item .env.example .env
# Docker Compose tự đọc .env ở thư mục gốc.

POSTGRES_DB=LibraryDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123

# Cổng trên máy host
DB_PORT=5433
API_PORT=5056
WEB_PORT=5173

# Đổi thành chuỗi ngẫu nhiên >= 32 ký tự trước khi triển khai thật.
JWT_SECRET=super_secret_key_for_development_huit_roman_12345

# Development: bật Swagger. Production: tắt Swagger, phù hợp triển khai thật.
ASPNETCORE_ENVIRONMENT=Development
