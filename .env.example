# Sao chép file này thành .env rồi điền giá trị thật:
#   Copy-Item .env.example .env
# Docker Compose tự đọc .env ở thư mục gốc; các script .bat cũng đọc .env khi chạy backend local.
# .env đã nằm trong .gitignore — KHÔNG commit giá trị thật lên Git.

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=LibraryDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<mật khẩu PostgreSQL>

# Cổng trên máy host
DB_PORT=5433
API_PORT=5056
WEB_PORT=5173

# JWT — bắt buộc, chuỗi ngẫu nhiên >= 32 ký tự
JWT_SECRET=<chuỗi ngẫu nhiên >= 32 ký tự>

# ── SMTP (Gmail App Password) ───────────────────────────────
# Bật xác minh 2 bước trên Gmail rồi tạo App Password (16 ký tự).
SMTP_USER=<email gửi thư, ví dụ ten@gmail.com>
SMTP_PASSWORD=<App Password 16 ký tự, giữ nguyên khoảng cách nếu có>
SMTP_SENDER_EMAIL=<trùng SMTP_USER>
SMTP_SENDER_NAME=Hệ thống quản lý phòng họp thư viện HUIT
SMTP_ENABLE_EMAIL=true

# ── MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=<tài khoản MinIO>
MINIO_ROOT_PASSWORD=<mật khẩu MinIO >= 8 ký tự>
MINIO_BUCKET_NAME=violations

# Development: bật Swagger. Production: tắt Swagger, phù hợp triển khai thật.
ASPNETCORE_ENVIRONMENT=Development
